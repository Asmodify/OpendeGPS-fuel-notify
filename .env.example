# Copy to .env on the server and fill in. Never commit .env.
DASHBOARD_PASSWORD=
SESSION_SECRET=
# set both to 1 once the dashboard is behind Caddy with HTTPS
TRUST_PROXY=0
COOKIE_SECURE=0
# Link to the Open Tee API (admin web + driver app). Same value as FUEL_WARNER_KEY on the API.
# Empty = link off.
OPENTEE_KEY=
